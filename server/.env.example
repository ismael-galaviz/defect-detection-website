STAFF_EMAIL=
PUBLIC_SITE_ORIGINS=http://localhost:5173
SITE_URL=http://localhost:5173
GOOGLE_FAKE=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
